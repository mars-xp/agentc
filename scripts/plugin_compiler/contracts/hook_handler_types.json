    "codex": {
      "group_fields": ["matcher"],
      "handler_types": ["command"],
      "shape": "nested",
      "source": "https://developers.openai.com/codex/hooks"
    }
  },
  "cross_host": [
    {
      "handler_type": "command",
      "action": "rewrite-plugin-root",
      "source": "https://code.claude.com/docs/en/plugins-reference"
    },
    {
