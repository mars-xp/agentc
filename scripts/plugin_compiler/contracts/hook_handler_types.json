    {
      "handler_type": "mcp_tool",
      "from_host": "claude-code",
      "to_host": "codex",
      "action": "block",
      "source": "https://developers.openai.com/codex/hooks"
    },
    {
      "handler_type": "agent",
      "from_host": "claude-code",
      "to_host": "cursor",
      "action": "block",
      "source": "https://prod.cursor.com/docs/hooks"
    },
    {
      "handler_type": "agent",
      "from_host": "claude-code",
      "to_host": "codex",
      "action": "block",
      "source": "https://developers.openai.com/codex/hooks"
