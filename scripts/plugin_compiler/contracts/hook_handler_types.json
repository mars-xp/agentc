{
  "handler_types": {
    "command": {
      "fields": ["command", "args", "timeout"],
      "source": "https://code.claude.com/docs/en/hooks"
    },
    "prompt": {
      "fields": ["prompt"],
      "source": "https://code.claude.com/docs/en/hooks"
    },
    "http": {
      "fields": ["url", "method", "headers"],
      "source": "https://code.claude.com/docs/en/hooks"
    },
    "mcp_tool": {
      "fields": ["tool", "server"],
      "source": "https://code.claude.com/docs/en/hooks"
    },
    "agent": {
      "fields": ["agent"],
      "source": "https://code.claude.com/docs/en/hooks"
    }
  },
  "hosts": {
    "cursor": {
      "group_fields": [],
      "handler_types": ["command", "prompt"],
      "shape": "flat",
      "source": "https://prod.cursor.com/docs/hooks"
    },
    "claude-code": {
      "group_fields": ["matcher", "timeout"],
