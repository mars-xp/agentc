{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/agent-project/v1.json",
  "title": "agent-project/v1",
  "description": "Machine-readable field list. Python validate_schema is authoritative.",
  "type": "object",
  "required": ["schemaVersion", "project"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "agent-project/v1" },
    "project": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "license": { "type": "string" }
      },
      "patternProperties": { "^x-": true }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": { "$ref": "#/$defs/targetHost" },
        "codex": { "$ref": "#/$defs/targetHost" },
        "claude-code": { "$ref": "#/$defs/targetHost" }
      },
      "patternProperties": { "^x-": true }
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": { "$ref": "#/$defs/stringList" },
        "rules": { "$ref": "#/$defs/stringList" },
        "commands": { "$ref": "#/$defs/stringList" },
        "agents": { "$ref": "#/$defs/stringList" },
        "hooks": { "$ref": "#/$defs/stringList" },
        "mcp": { "$ref": "#/$defs/stringList" }
      },
      "patternProperties": { "^x-": true }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopes": { "$ref": "#/$defs/stringList" },
        "conflictPolicy": { "type": "string" },
        "portabilityPolicy": {
          "type": "string",
          "enum": ["strict", "compatible", "permissive"]
        }
      },
      "patternProperties": { "^x-": true }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executables": { "$ref": "#/$defs/nameList" },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "optional": { "$ref": "#/$defs/nameList" },
            "required": { "$ref": "#/$defs/nameList" }
          },
          "patternProperties": { "^x-": true }
        }
      },
      "patternProperties": { "^x-": true }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretPolicy": { "type": "string" },
        "allowNetwork": { "type": "string" },
        "forbidAbsolutePaths": { "type": "boolean" }
      },
      "patternProperties": { "^x-": true }
    }
  },
  "patternProperties": { "^x-": true },
  "$defs": {
    "targetHost": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "patternProperties": { "^x-": true }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nameList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Names only: no '=', URLs, or path-shaped values."
      }
    }
  }
}
